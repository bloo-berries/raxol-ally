# Otari gateway (hosted or self-hosted)
# Hosted: https://api.otari.ai/api/v1
# Self-hosted: http://localhost:8000/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_API_KEY=your_virtual_key_here
OTARI_MASTER_KEY=your_master_key_here

# SSH surface: set ALLY_SSH_ENABLED=true to serve the TUI on localhost:ALLY_SSH_PORT
ALLY_SSH_ENABLED=false
ALLY_SSH_PORT=2222

# Routing policy defined in Otari (config.yml or POST /api/v1/routing/policies).
# Alt text and long descriptions are sent with model=<policy>; Otari fails over
# from the primary VLM to the fallback server-side.
ALLY_ROUTING_POLICY=ally-failover

# Vision models, in Otari's provider:model form. These are the policy's
# candidates; Ally also lists them on tenant key allow-lists.
ALLY_PRIMARY_MODEL=alibaba/qwen-3.5-397b-a17b
ALLY_FALLBACK_MODEL=alibaba/qwen-3.5-35b-a3b

# Second open VLM, used only for the decorative/informative classification.
ALLY_DECORATIVE_MODEL=alibaba/qwen-3.5-35b-a3b
# Model for gateway tools (code execution for WCAG contrast, web fetch for the
# audit page summary). Must support tool calling.
# Defaults to the routing policy when unset.
ALLY_TOOL_MODEL=alibaba/qwen-3.5-397b-a17b

# Guardrail profile from GET /api/v1/tool-settings/guardrails/profiles.
# Leave unset to send no guardrails. Mode: monitor (verdict in header) or block (403).
ALLY_GUARDRAIL_PROFILE=prompt-injection
ALLY_GUARDRAIL_MODE=monitor

# Per-tenant budgets (USD per 24h rolling window)
ALLY_TENANT_BUDGET_USD=1.00
